# Copy to .env for local Docker Compose. Never commit the copied file.
DATABASE_URL=postgresql://chefvision:chefvision@db:5432/chefvision

# Replace this with a long random value in every non-demo environment.
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional local overrides.
DATABASE_SSL=disable
STORAGE_MODE=db
MAX_UPLOAD_BYTES=10485760
